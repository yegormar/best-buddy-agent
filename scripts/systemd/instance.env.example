# Copy to /etc/best-buddy/instances/<name>.env (generated by install-systemd-instance.sh)
# BB_ROOT is the only path variable — all install files live under this directory.

BB_ROOT=/opt/best-buddy-agent

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
BEST_BUDDY_AGENT_CONF=/opt/best-buddy-agent/conf/best_buddy_agent.conf
BEST_BUDDY_AGENT_DATA_DIR=/opt/best-buddy-agent/data
